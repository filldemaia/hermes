{
  "name": "hermes",
  "version": "1.0.0",
  "private": true,
  "description": "Hermes — Plataforma de streaming en català (catàleg TMDb + reproducció de contingut lliure)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "db:init": "tsx src/db-init.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "better-sqlite3": "12.6.2",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}